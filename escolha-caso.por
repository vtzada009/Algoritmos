programa {
  funcao inicio() {
    inteiro opcao
    escreva("Escolha(1-3):")
    leia(opcao)

    escolha(opcao) {
      caso 1:
       escreva("cadastrar usuário")
      pare
    caso 2:
       escreva("lista usuário")
      pare
    caso 3:
       escreva("sair sistema")
      pare
      caso contrario:
       escreva("opção inválida!")
    }
  }
}
