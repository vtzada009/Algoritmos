programa {
  funcao inicio() {
    //declaração da variavel criando a "caixa")
    cadeia nomeUsuario

    //ENTERADA:captura dados do usuario
    escreva("Digite seu nome")
    leia(nomeUsuario)

    //SAIDA:exibindo o resultado
    escreva("olá,", nomeUsuario, "!")
  }
}
