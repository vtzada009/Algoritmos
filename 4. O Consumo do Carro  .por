programa {
  funcao inicio() {
    real kilometros, litros, mediaConsumo

    escreva("Quantos km percorrido: ", kilometros)
    leia(kilometros)

    escreva("litros gasto por km rodado: ", litros)
    leia(litros)

    mediaConsumo = kilometros / litros

    escreva("Seu consumo medio ", mediaConsumo)
  }
}
