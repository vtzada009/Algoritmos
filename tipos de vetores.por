programa {
  funcao inicio() {
    inteiro notas[5]
    real altura[10]
    cadeia nomes[3]
    logico respostas[4]

    nomes [0] = "Ana"
    nomes [1] = "Bruno"
    nomes [2] = "Carla"

    notas [0] = 7
    notas [1] = 6
    notas [2] = 5
    notas [3] = 4
    notas [4] = 3

    altura[0] = 2.20
    altura[1] = 2.10
    altura[2] = 2.05
    altura[3] = 1.90
    altura[4] = 1.85
    altura[5] = 1.80
    altura[6] = 1.75
    altura[7] = 1.70
    altura[8] = 1.65
    altura[9] = 1.60
    
    respostas[0] = verdadeiro
    respostas[1] = falso
    respostas[2] = verdadeiro
    respostas[3] = falso

    escreva(nomes[0], "\n")
    escreva(nomes[1], "\n")
    escreva(nomes[2], "\n")
    escreva(notas[0], "\n")
    escreva(notas[1], "\n")
    escreva(notas[2], "\n")
    escreva(notas[3], "\n")
    escreva(notas[4], "\n")
    escreva(altura[0], "\n")
    escreva(altura[1], "\n")
    escreva(altura[2], "\n")
    escreva(altura[3], "\n")
    escreva(altura[4], "\n")
    escreva(altura[5], "\n")
    escreva(altura[6], "\n")
    escreva(altura[7], "\n")
    escreva(altura[8], "\n")
    escreva(altura[9], "\n")
    escreva(respostas[0], "\n")
    escreva(respostas[1], "\n")
    escreva(respostas[2], "\n")
    escreva(respostas[3], "\n")
  }
}
