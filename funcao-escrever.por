programa {
  funcao inicio() {
    cadeia nome
    inteiro pontos,idade
    
    nome = "enzo"
    pontos = 1300
    idade = 16 
    escreva("ola, mundo! \n")
    escreva(nome, " tem ", idade, " anos de idade.\n")
    escreva(nome, " tem ", idade, " meses de free fire e apostado em cada jogo, com isso ele conseguiu ganhar ", pontos ,"pontos em uma partida")
  }
}
