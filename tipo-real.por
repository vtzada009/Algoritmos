programa {
  funcao inicio() {
    real preco = 25.90
    real mediaNota = 9.50
    real pesoPacote = 1.350

    escreva("O preço informado é de R$", preco," com dsesconto")
    escreva("\n a aluna gabrielly do ensino medio deve ter tirado ", mediaNota," na diciplina de fisica")
    escreva("\n fui ao beco aprendi um cara com ", pesoPacote, " Gramas de maco mais onha dentro do quarto")
  }
}
